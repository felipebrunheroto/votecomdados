									"pm.test('responde 200', () => pm.response.to.have.status(200));",
									"const b = pm.response.json();",
									"pm.test('trajetória vem da mais recente para a mais antiga', () => {",
									"    const anos = b.trajetoria.map(c => c.anoEleicao);",
									"    pm.expect(anos).to.eql([...anos].sort((a, z) => z - a));",
									"});",
									"pm.test('cobre os três níveis', () => {",
									"    const esferas = b.trajetoria.map(c => c.esfera);",
									"    ['FEDERAL', 'ESTADUAL', 'MUNICIPAL'].forEach(e =>",
									"        pm.expect(esferas).to.include(e));",
									"});",
									"pm.test('SP resolve para a Alesp, não para o fallback genérico', () => {",
									"    const alesp = b.cobertura.find(c =>",
									"        c.esfera === 'ESTADUAL' && c.uf === 'SP' && c.recurso === 'voto_nominal');",
									"    pm.expect(alesp.status).to.eql('NAO_PUBLICADO_PELA_FONTE');",
									"});"
