<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>br.org.votecomdados</groupId>
  <artifactId>votecomdados</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>VoteComDados</name>

  <modules>
    <module>votecomdados-core</module>
    <module>votecomdados-api</module>
    <module>votecomdados-ingestion</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <testcontainers.version>2.0.5</testcontainers.version>
    <awssdk.version>2.54.13</awssdk.version>

    <!--
      Sobrescreve o Tomcat que o Spring Boot 4.1.1 traz (11.0.24), que tem
      três CVEs CRITICAL com correção publicada — todas de bypass de
      autenticação/autorização, achadas pelo `trivy image` do CI em
      07/09/2026:

        CVE-2026-65182  bypass de restrição de segurança
        CVE-2026-65905  bypass de autenticação por replay no DIGEST
        CVE-2026-68525  acesso não autorizado via bypass do FORM

      Override pontual em vez de subir o Spring Boot inteiro: é a mudança
      menor que resolve, e a API é pública e anônima — a superfície que
      essas CVEs atacam é exatamente a dela. Remover quando o Spring Boot
      passar a trazer 11.0.25+ por conta própria.
    -->
    <tomcat.version>11.0.25</tomcat.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!--
        SDK da AWS só no módulo de ingestão, e só para S3: é ele que entrega o
        pacote do TSE ao container e publica os dados abertos (ver
        ArmazenamentoDeObjetos). A API não depende disto — ela fala com o
        Postgres por credencial, não com serviço da AWS.
      -->
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${awssdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
