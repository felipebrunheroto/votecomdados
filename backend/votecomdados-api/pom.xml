<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>br.org.votecomdados</groupId>
    <artifactId>votecomdados</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>votecomdados-api</artifactId>
  <name>VoteComDados :: api</name>
  <description>
    Serviço HTTP somente leitura. Contrato em docs/API.md.
  </description>

  <dependencies>
    <dependency>
      <groupId>br.org.votecomdados</groupId>
      <artifactId>votecomdados-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!--
      Jackson declarado explicitamente porque o código o USA diretamente: a
      projeção perfil_leitura guarda trajetória e cobertura em JSONB, e o
      repositório desserializa nos records do domínio.
      ATENÇÃO ao groupId: o Spring Boot 4 migrou para o Jackson 3
      (`tools.jackson`), e é esse o ObjectMapper que ele registra como bean.
      Declarar `com.fasterxml.jackson.core` (Jackson 2) compila, mas a injeção
      falha no start com "required a bean of type ObjectMapper".
    -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!--
      No Spring Boot 4 as auto-configurações foram divididas em módulos: só
      `flyway-core` no classpath NÃO ativa a execução das migrations. É o
      starter que traz a FlywayAutoConfiguration.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
